{
  "name": "nature-theme-vision-therapy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:vercel": "vercel dev",
    "prepare": "husky",
    "cy:open": "cypress open",
    "cy:open:component": "cypress open --component",
    "cy:open:e2e": "cypress open --e2e",
    "cy:run:component": "cypress run --component",
    "cy:run:e2e": "cypress run --e2e",
    "test": "pnpm run cy:run:component && npm run cy:run:e2e",
    "lint": "eslint \"{src,components,cypress}/**/*.{ts,tsx}\"",
    "lint:fix": "pnpm lint --fix"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.1",
    "bcryptjs": "^3.0.2",
    "cookie": "^1.0.2",
    "daisyui": "^5.0.40",
    "dotenv": "^17.2.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.16.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cypress/react": "9.0.1",
    "@cypress/vite-dev-server": "7.0.0",
    "@eslint/js": "^9.25.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vercel/node": "^5.3.22",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "cypress": "^15.3.0",
    "cypress-react-selector": "^3.0.0",
    "eslint": "^9.25.0",
    "eslint-plugin-cypress": "^5.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.0",
    "lint-staged": "^16.2.2",
    "postcss": "^8.5.3",
    "pretty-quick": "^4.2.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vercel": "^48.2.0",
    "vite": "^6.3.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "pretty-quick --staged",
      "pnpm lint"
    ],
    "*.{ts,tsx}": [
      "pnpm cy:run:component"
    ]
  }
}
